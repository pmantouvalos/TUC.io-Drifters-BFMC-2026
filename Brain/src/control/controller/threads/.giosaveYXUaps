    def _update_tof_state(self, side: str, raw_value):
        """
        Push a new reading into the rolling buffer for the given side
        ('left' or 'right') and update the hysteresis-based free/occupied
        state.  Returns the current boolean free-state (or None if the
        buffer is still warming up).
        """
        buf = self._tof_left_buf if side == "left" else self._tof_right_buf
        state_attr = "_tof_left_free" if side == "left" else "_tof_right_free"

        buf.append(raw_value)

        current = getattr(self, state_attr)

        # ── Asymmetric hysteresis ─────────────────────────────────────────────
        # FREE → OCC : instant (1 reading) — never miss a parked car
        # OCC → FREE : slow   (full median buffer) — never commit to wrong spot

        if current is True:
            # Currently FREE — go OCC immediately on a single low reading
            if raw_value < TOF_FREE_LOW:
                setattr(self, state_attr, False)
                buf.clear()  # flush buffer so old FREE readings don't linger
        else:
            # Currently OCC — need full buffer median to confirm FREE
            if len(buf) >= max(1, TOF_BUFFER_SIZE // 2):
                median = float(np.median(buf))
                if median > TOF_FREE_HIGH:
                    setattr(self, state_attr, True)

        return getattr(self, state_attr)

