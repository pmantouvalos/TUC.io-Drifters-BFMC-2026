    def state_change_handler(self):
        message = self.stateChangeSubscriber.receive()
        if message is not None:
            match message:
                case "DEFAULT" | "STOP" | "LEGACY":
                    self.control_mode = ControlMode.INIT
                    print(
                        f"\033[1;97m[ Controller Thread ] :\033[0m "
                        f"\033[1;92mINFO\033[0m - Mode → {message}"
                    )
                case "MANUAL":
                    self.control_mode = ControlMode.MANUAL
                    print(
                        "\033[1;97m[ Controller Thread ] :\033[0m "
                        "\033[1;92mINFO\033[0m - Mode → MANUAL"
                    )
                case "AUTO":
                    self.control_mode = ControlMode.AUTO
                    print(
                        "\033[1;97m[ Controller Thread ] :\033[0m "
                        "\033[1;92mINFO\033[0m - Mode → AUTO"
                    )

    # ─────────────────────────────────────────────────────────────────────────
    # LIFECYCLE
    # ─────────────────────────────────────────────────────────────────────────

    def try_unsubscribe(self):
        try:
            for sub in self.subscribe_list:
                try:
                    sub.unsubscribe()
                except Exception:
                    pass
        except Exception:
            pass

    def stop(self):
        self.try_unsubscribe()
        self.control_mode = ControlMode.INIT
        self.steerMotorSender.send("0")
        self.speedMotorSender.send("0")
