            tofForwardRecv = self.tofForwardSubscriber.receive()
            objectDetectRecv = self.objectDetectSubscriber.receive()
            semaphoresRecv = self.semaphoresSubscriber.receive()
            locationRecv = self.locationSubscriber.receive()
            navigateToRecv = self.navigateToSubscriber.receive()
            currentSpeedRecv = self.currentSpeedSubscriber.receive()
            imuRecv = self.imuSubscriber.receive()
            intersectionMaskRecv = self.intersectionMaskSubscriber.receive()
            leftLineClassifierRecv = self.leftLineClassifierSubscriber.receive()
            rightLineClassifierRecv = self.rightLineClassifierSubscriber.receive()
            # navCommandRecv = self.navCommandSubscriber.receive()

            # if leftLineClassifierRecv is not None:
            #     print(f"[LeftLineClassifier] {leftLineClassifierRecv}")
            # if rightLineClassifierRecv is not None:
            #     print(f"[RightLineClassifier] {rightLineClassifierRecv}")

            if imuRecv is not None:
                data = ast.literal_eval(
                    imuRecv
                )  # stupid string becomes smart dictionary
                yaw = float(data["yaw"])
                self.current_yaw = yaw  # <--- ΠΡΟΣΘΗΚΗ: Το σώζουμε για το State Machine
                self.sharedMemory.insert("deviceRot", [yaw])












            if currentSpeedRecv is not None:
                currentSpeedRecv = currentSpeedRecv / 10
                self.sharedMemory.insert(
                    "deviceSpeed", [round(currentSpeedRecv), 2]
                )  # send a speed to the server

            # ── Navigator Commands ─────────────────────────────────────────

            if self.navCommandSubscriber.is_data_in_pipe(): # <--- THIS IS CRITICAL
                navCommandRecv = self.navCommandSubscriber.receive()
                
                sequence = navCommandRecv.get("maneuver_sequence")
                lane_pref = navCommandRecv.get("lane_preference")
                stop_cmd = navCommandRecv.get("command")
                
                if lane_pref is not None:
                    self.lane_preference = lane_pref

                if stop_cmd == "STOP_AT_DESTINATION":
                    print("\033[1;95m>>> [ NAVIGATOR ] DESTINATION REACHED. STOPPING.\033[0m")
                    self.control_mode = ControlMode.INIT

                if sequence is not None:
                    print(f"\033[1;95m>>> [ NAVIGATOR ] Queue Loaded: {sequence}\033[0m")
                    self.maneuver_queue = sequence
                    
                    # Pre-load the immediate next turn
                    if len(self.maneuver_queue) > 0:
                        next_cmd = self.maneuver_queue.pop(0)
                        # String magic: turns "TURN_LEFT" into "left", "GO_STRAIGHT" into "straight"
                        self.next_instruction = next_cmd.replace("TURN_", "").replace("GO_", "").lower()

            # ── Cache ToF ─────────────────────────────────────────────────
            if tofRearRecv is not None:
                self.tof_rear = tofRearRecv
                #self._update_tof_state("rear", tofRearRecv)  # rear also gets hysteresis, for parking exit
            if tofForwardRecv is not None:
                self.tof_forward = tofForwardRecv
                #self._update_tof_state("forward", tofForwardRecv)
            if tofLeftRecv is not None:
                self.tof_left = tofLeftRecv
                self._update_tof_state("left", tofLeftRecv)
            if tofRightRecv is not None:
                self.tof_right = tofRightRecv
                self._update_tof_state("right", tofRightRecv)

            #print(f"TOF L/R/Fwd/Aft: {self.tof_left} / {self.tof_right} / {self.tof_forward} / {self.tof_rear}")
            #print(f"TOF L/R/F/R: {self.tof_left} / {self.tof_right} / {self.tof_forward} / {self.tof_rear}")

            # ── Update detections ─────────────────────────────────────────
            if objectDetectRecv is not None:
                # 1. We got fresh data from the camera, save it!
                self.detections = (
                    objectDetectRecv
                    if isinstance(objectDetectRecv, list)
                    else [objectDetectRecv]
                )
                detected_labels = [
                    d.get("label") for d in self.detections if d is not None
                ]
                # if len(detected_labels) > 0:
                # print(f"[BRAIN SEES]: {detected_labels}")

                # if "start" in detected_labels:
                # --------------------------------------------------------------
                self._last_detection = self.detections  # Update our memory

                self._report_obstacles()
            else:
                # 2. Queue was empty (camera still processing), use our memory!
                self.detections = (
                    self._last_detection if self._last_detection is not None else []
                )

            # 3. Print the active memory we are using to drive, NOT the empty queue pull
            # print(f"ObjectDetect: {self.detections}")

            # ── V2X updates ───────────────────────────────────────────────
            self._update_semaphores(semaphoresRecv)
            self._update_location(locationRecv)

            # ── Navigate-to command from dashboard ────────────────────────
            if navigateToRecv is not None:
                target = str(navigateToRecv.get("target", "")).strip()
                if target and self.planner and target in self.planner._pos:
                    self.target_node_id = target
                    self.current_path = []
                    self.current_node_idx = 0
                    self._fixed_target = True
                    print(
                        f"\033[1;97m[ PathPlanner ] :\033[0m \033[1;92mINFO\033[0m"
                        f" - NavigateTo → node {target}"
                    )
                else:
                    print(
                        f"\033[1;97m[ PathPlanner ] :\033[0m \033[1;93mWARN\033[0m"
                        f" - NavigateTo: unknown node '{target}'"
                    )

            # =================================================================
            # PREPARE
            # =================================================================
            if klemRecv is not None:
                self._klem_received = True
                prev = self.act_enabled
                match str(klemRecv):
                    case "30":
                        self.act_enabled = True
                    case _:
                        self.act_enabled = False
                if prev != self.act_enabled:
                    print(f"\033[1;96m[KLEM]\033[0m act_enabled={self.act_enabled}")
            else:
                if not self._klem_received:
                    self.act_enabled = True

            if buttonRecv is not None:
                match int(buttonRecv):
                    case 0:
                        self.stateMachine.request_mode("dashboard_stop_button")
                    case 1:
                        self.stateMachine.request_mode("dashboard_manual_button")
                    case 2:
                        self.stateMachine.request_mode("dashboard_legacy_button")
                    case 3:
                        self.stateMachine.request_mode("dashboard_auto_button")

            # =================================================================
            # ACT — state machine
            # =================================================================
            match self.control_mode:

                # ── INIT ──────────────────────────────────────────────────────
                case ControlMode.INIT:
                    self.steerMotorSender.send("0")
                    self._send_speed(0)
                    self.control_mode = ControlMode.IDLE
                    time.sleep(0.03)

                # ── IDLE ──────────────────────────────────────────────────────
                case ControlMode.IDLE:
                    
                    self.control_mode = ControlMode.START
                    

                # ── MANUAL ────────────────────────────────────────────────────
                case ControlMode.MANUAL:
                    if self.act_enabled and axesRecv is not None:
                        sv = map_range(
                            float(axesRecv["steering"]),
                            0.0,
                            AXES_MAX,
                            STEERING_MIN,
                            STEERING_MAX,
                        )
                        tv = map_range(
                            float(axesRecv["throttle"]),
                            0.0,
                            AXES_MAX,
                            THROTTLE_MIN,
                            THROTTLE_MAX,
                        )
                        if abs(sv) < STEERING_DEADBAND:
                            sv = 0.0
                        if abs(tv) < THROTTLE_DEADBAND:
                            tv = 0.0
                        self.steerMotorSender.send(
                            str(int(constrain_num(sv, STEERING_MIN, STEERING_MAX)))
                        )
                        self._send_speed(
                            int(constrain_num(tv, THROTTLE_MIN, THROTTLE_MAX))
                        )
                        time.sleep(0.03)

                # ── AUTO ──────────────────────────────────────────────────────
                case ControlMode.AUTO:
                    self._log_once("AUTO mode")
                    if self.act_enabled:
                        if time.time() < getattr(self, "_ignore_intersections_until", 0):
                            self.detections = [
                                obj for obj in self.detections 
                                if obj is not None and obj.get("label") not in ["Stop", "Priority", "TrafficLight", "STOP_LINE", "Crosswalk"]
                            ]

                        if self.nearest_semaphore_state == 0:  # RED
                            self.steerMotorSender.send("0")
                            self._send_speed(0)
                            if self.debugging:
                                print("[ SEMAPHORE ] RED → STOP")
                            self._send_telemetry()
                            return

                        # Lane keeping
                        self._apply_lane_keeping(visionRecv, axesRecv, NORMAL_SPEED, side=self.lane_preference)

                        # PRIORITY 1. ENSURE PEDESTRIAN SAFETY
                        # ALL OTHER CONSIDERATIONS SECONDARY
                        # SANITY EXPENDABLE
                        start_seen = False

                        # if any(
                        #         start_seen == False
                        #         and obj is not None
                        #         and obj.get("label") == "start"
                        #         and obj.get("proximity") in ("CLOSE", "MEDIUM")
                        #         for obj in self.detections 
                        #     ): 
                        #     start_seen = True
                        #     print("start")

                        #     self.control_mode = ControlMode.START



                        if any(
                            obj is not None
                            and obj.get("label") == "Pedestrian"
                            and obj.get("proximity") == "CLOSE"
                            for obj in self.detections
                        ) and not any(
                            obj is not None and obj.get("label") == "Crosswalk"
                            for obj in self.detections
                        ):
                            self.control_mode = ControlMode.SIMPLE_PEDESTRIAN

                        # Priority 2
                        elif (
                            any(
                                obj is not None
                                and obj.get("label") == "Stop"
                                and obj.get("proximity") in ("CLOSE", "MEDIUM", "FAR")
                                for obj in self.detections
                            )
                            or self._searching_for_stop_line
                        ):

                            if any(
                                obj is not None
                                and obj.get("label") == "Stop"
                                and obj.get("proximity") in ("CLOSE", "MEDIUM")
                                for obj in self.detections
                            ):
                                print(
                                    ">>> Stop sign detected → searching for stop line"
                                )
                            self._searching_for_stop_line = True
                            self.control_mode = ControlMode.FIND_STOP_LINE

                        # Priority 2 — Pedestrian + Crosswalk
                        elif any(
                            obj is not None
                            and obj.get("label") == "Pedestrian"
                            and obj.get("proximity") in ("CLOSE", "MEDIUM")
                            for obj in self.detections
                        ) and any(
                            obj is not None
                            and obj.get("label") == "Crosswalk"
                            and obj.get("proximity") in ("CLOSE", "MEDIUM")
                            for obj in self.detections
                        ):
                            self.control_mode = (
                                ControlMode.MOVE_FOR_PEDESTRIAN_IN_CROSSWALK
                            )

                        # Priority 3 — Green light (proceed but prepare to stop at stop line)
                        elif any(
                            obj is not None
                            and "traffic" in obj.get("label", "").lower()
                            and obj.get("proximity") in ("CLOSE", "MEDIUM", "FAR")
                            for obj in self.detections
                        ) and not any(
                            obj is not None and obj.get("label") == "GreenLight"
                            for obj in self.detections
                        ):
                            print(
                                ">>> Traffic light detected but NOT green → prepare to stop at stop line"
                            )
                            self._searching_for_stop_line = True
                            self.control_mode = ControlMode.FIND_STOP_LINE

                        # Priority 4 — Priority (pass through directly to intersection)
                        elif any(
                            obj is not None
                            and obj.get("label") == "Priority"
                            and obj.get("proximity") in ("CLOSE", "MEDIUM", "FAR")
                            for obj in self.detections
                        ):
                            self._log_once("PRIORITY SIGN -> ENTER INTERSECTION")
                            self.control_mode = ControlMode.ENTER_INTERSECTION

                        # Priority 5 — Highway
                        elif any(
                            obj is not None
                            and obj.get("label") == "HighwayEntry"
                            and obj.get("proximity") == "CLOSE"
                            for obj in self.detections
                        ):
                            
                            self.control_mode = ControlMode.ENTER_HIGHWAY

                        # Priority 6 — Parking
                        elif any(
                            obj is not None
                            and obj.get("label") == "Parking"
                            and obj.get("proximity") in ("CLOSE")
                            for obj in self.detections
                        ):
                            self._log_once("PARKING SIGN DETECTED → prepare to park")
                            self.control_mode = ControlMode.ENTER_PARKING

                        # elif not self._has_started and any(
                        #     obj is not None and obj.get("label") == "start"
                        #     for obj in self.detections
                        # ):
                        #     print(">>> START LINE DETECTED -> Locking in START mode! <<<")
                        #     self.control_mode = ControlMode.START

                        # Priority 7 — Overtake
                        elif any(
                            obj is not None
                            and obj.get("label") == "Car"
